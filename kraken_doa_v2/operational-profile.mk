# TT-01 operational Linux Make build: one set of definitions for every host TU.
# Private P25 wire extensions must agree across SDK, host and all child TUs.
# Explicit offline test builds retain their separately recorded compiler commands.
TT01_HOST_FEATURES := TT01_DSP_RECEIPT_QUALIFICATION \
    TT01_RAW_LOSS_QUALIFICATION \
    TT01_RECEIVER_QUALIFICATION \
    TT01_WORKER_QUALIFICATION \
    TT01_ROLE_QUALIFICATION \
    TT01_GENERATION_QUALIFICATION \
    TT01_SAMPLE_QUALIFICATION \
    TT01_EVENT_AUDIT_QUALIFICATION \
    TT01_LIFECYCLE_QUALIFICATION \
    TT01_HANDOVER_QUALIFICATION \
    TT01_MANAGED_LOSS_QUALIFICATION \
    TT01_MANAGED_STAGE_LOSS_QUALIFICATION \
    TT01_INTEGRATED_RESIDUAL_QUALIFICATION \
    TT01_MANUAL_RUNNER_QUALIFICATION \
    TT01_MANUAL_OUTPUT_QUALIFICATION \
    TT01_MANUAL_CONTINUITY_QUALIFICATION \
    TT01_MANUAL_LOSS_QUALIFICATION \
    TT01_MANUAL_ORIGIN_QUALIFICATION \
    TT01_PRODUCER_COLD_QUALIFICATION \
    TT01_K_SHADOW_QUALIFICATION \
    TT01_K_TYPED_CONTROL_QUALIFICATION \
    TT01_K_PLACEMENT_QUALIFICATION \
    TT01_L_BOUNDED_QUALIFICATION \
    TT01_D1_PCM_QUALIFICATION \
    TT01_D2_MANAGER_QUALIFICATION \
    TT01_D2_MIXER_QUALIFICATION \
    TT01_D2_PUBLISH_QUALIFICATION \
    TT01_D3_TRANSPORT_QUALIFICATION
TT01_WIRE_FEATURES := TT01_K_CONTROL_WIRE \
    TT01_D1_PCM_WIRE
TT01_OFFLINE_ONLY := TT01_INTEGRATED_TEST_SEAM \
    TT01_MANAGER_TRANSACTION_TEST \
    TT01_RECEIVER_TEST \
    TT01_WRITER_TEST \
    TT01_STAGE_CAP_STRESS \
    TT01_HANDOVER_TRACE
TT01_HOST_FLAGS := -DTT01_OPERATIONAL_BUILD $(addprefix -D,$(TT01_HOST_FEATURES) $(TT01_WIRE_FEATURES))
TT01_PLUGIN_FLAGS := $(addprefix -D,$(TT01_WIRE_FEATURES))
TT01_FORBIDDEN_FLAGS := $(foreach f,$(TT01_OFFLINE_ONLY),-D$(f) -D$(f)=%)
ifneq ($(strip $(filter $(TT01_FORBIDDEN_FLAGS),$(CXXFLAGS) $(CPPFLAGS))),)
$(error TT-01 offline-only flags are not permitted in the operational Make build)
endif
